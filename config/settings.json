{
  "permissions": {
    "deny": [
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git stash drop *)",
      "Bash(git checkout -- *)",
      "Bash(git checkout . *)",
      "Bash(git restore *)",
      "Bash(git rebase *)",
      "Bash(git branch -D *)",
      "Bash(git -C * push*)"
    ],
    "ask": [
      "Bash(git commit *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/guard_rm_variable_path.py\"",
            "timeout": 60,
            "statusMessage": "Checking rm paths"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/guard_shellcheck_rules.py\"",
            "timeout": 60,
            "statusMessage": "Checking ShellCheck rules"
          }
        ]
      }
    ]
  },
  "model": "opus",
  "enableWorkflows": true,
  "feedbackDrafts": "notify",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "pluginConfigs": {
    "cc-plugin-agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
      }
    }
  },
  "theme": "dark",
  "preferredNotifChannel": "auto",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
